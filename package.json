{
  "name": "stickyprint",
  "version": "1.0.0",
  "private": true,
  "description": "Print on sticky notes stuck to a sheet of paper, with a mono laser printer.",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "test": "node --test test/*.test.js",
    "samples": "node scripts/make-samples.js",
    "check": "node scripts/make-samples.js && python3 scripts/check-samples.py",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "fast-png": "6.4.0",
    "jspdf": "4.2.1"
  }
}
